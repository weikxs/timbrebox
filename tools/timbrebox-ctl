#!/usr/bin/env bash
# timbrebox-ctl — control a running TimbreBox player from the command line.
#
# TimbreBox exposes a loopback HTTP control API (Settings → General → Agent
# control, on by default). This script auto-discovers the endpoint from
# ~/.timbrebox/control.json (written by the app while the API is enabled) or
# the fixed port range, so an agent or shell never needs to know the port.
#
# Every request carries the app's per-run token (header X-TimbreBox-Token),
# read from TIMBREBOX_TOKEN, the file named by TIMBREBOX_TOKEN_FILE, or the
# app's user-only control-token file in its support directory. The token is
# handed to curl on stdin, never on its command line.
#
# Usage:
#   timbrebox-ctl status | search-status | playback-status
#   timbrebox-ctl search "周杰伦"
#   timbrebox-ctl play-ref <source> <item>
#   timbrebox-ctl play | pause | toggle | next | prev | stop
#   timbrebox-ctl seek <ms> | volume <0..1> | mode <queue|track|off|shuffle>
#   timbrebox-ctl queue | sources | lyric | play-queue <index>
#   timbrebox-ctl source <id> <true|false>
#   timbrebox-ctl quit          # quit the whole app (background instance)
set -euo pipefail

EP_FILE="${TIMBREBOX_CONTROL:-${HOME}/.timbrebox/control.json}"

die() { echo "timbrebox-ctl: $*" >&2; exit 1; }

# Where the running app keeps its token, most likely first.
token_paths() {
  if [ -f "${EP_FILE}" ]; then
    python3 -c "import json;print(json.load(open('${EP_FILE}')).get('tokenFile',''))" 2>/dev/null || true
  fi
  case "$(uname -s)" in
    Darwin)
      local id="io.timbrebox.timbreboxApp"
      printf '%s\n' \
        "${HOME}/Library/Containers/${id}/Data/Library/Application Support/${id}/control-token" \
        "${HOME}/Library/Application Support/${id}/control-token" ;;
    Linux)
      local data="${XDG_DATA_HOME:-${HOME}/.local/share}"
      printf '%s\n' \
        "${data}/io.timbrebox.timbrebox_app/control-token" \
        "${data}/timbrebox_app/control-token" ;;
    MINGW*|MSYS*|CYGWIN*)
      printf '%s\n' "${APPDATA:-}/io.timbrebox/TimbreBox/control-token" ;;
  esac
}

read_token() {
  if [ -n "${TIMBREBOX_TOKEN:-}" ]; then printf '%s' "${TIMBREBOX_TOKEN}"; return; fi
  local f
  if [ -n "${TIMBREBOX_TOKEN_FILE:-}" ]; then
    [ -r "${TIMBREBOX_TOKEN_FILE}" ] && tr -d '[:space:]' < "${TIMBREBOX_TOKEN_FILE}"
    return
  fi
  while IFS= read -r f; do
    if [ -n "${f}" ] && [ -r "${f}" ]; then tr -d '[:space:]' < "${f}"; return; fi
  done < <(token_paths)
}

TOKEN="$(read_token || true)"

# curl with the token header fed on stdin (not visible in the process list).
tcurl() { printf 'X-TimbreBox-Token: %s\n' "${TOKEN}" | curl -H @- "$@"; }

# Verify a base URL is actually the TimbreBox control API (not some other app).
is_timbrebox() { tcurl -s "${1}/" 2>/dev/null | grep -q 'TimbreBox control API'; }

# The app answers but refuses the token (missing, or from an earlier run).
token_refused() { tcurl -s "${1}/" 2>/dev/null | grep -q 'X-TimbreBox-Token'; }
refused() {
  die "TimbreBox 拒绝了令牌（每次启动都会更换；找不到时用 TIMBREBOX_TOKEN_FILE 指向 control-token 文件）"
}

base_url() {
  # 1) discovery file (works for non-sandboxed installs).
  if [ -f "${EP_FILE}" ]; then
    local a
    a="$(python3 -c "import json;print(json.load(open('${EP_FILE}'))['address'])" 2>/dev/null \
        || grep -oE 'http://127\.0\.0\.1:[0-9]+' "${EP_FILE}" | head -1 || true)"
    if [ -n "${a}" ] && is_timbrebox "${a}"; then printf '%s' "${a}"; return; fi
    if [ -n "${a}" ] && token_refused "${a}"; then refused; fi
  fi
  # 2) scan the preferred loopback port range (the macOS sandbox hides the file
  #    from an external CLI, but the fixed ports are always reachable).
  local p
  for p in 8787 8788 8789 8790 8791 8792 8793 8794 8795 8796; do
    if is_timbrebox "http://127.0.0.1:${p}"; then
      printf 'http://127.0.0.1:%s' "${p}"; return
    fi
    if token_refused "http://127.0.0.1:${p}"; then refused; fi
  done
  die "找不到运行中的 TimbreBox 控制接口（确认应用已启动且已开启 Agent 控制）"
}

req() { tcurl -sS "${@}"; echo; }
# Actions must be POST: the player refuses them as GET so a web page cannot
# trigger them through the browser.
act() { tcurl -sS -X POST "${@}"; echo; }

main() {
  local cmd="${1:-help}"; shift || true
  case "${cmd}" in
    help|-h|--help)
      grep '^#' "${0}" | sed 's/^# \{0,1\}//' | sed '1d'
      return 0 ;;
  esac
  local BASE; BASE="$(base_url)"
  case "${cmd}" in
    status|search-status|playback-status|queue|sources|lyric)
      req "${BASE}/${cmd}" ;;
    play|pause|toggle|next|previous|stop|quit)
      act "${BASE}/${cmd}" ;;
    prev)         act "${BASE}/previous" ;;
    seek)         [ ${#} -ge 1 ] || die "用法: seek <ms>"; act -G "${BASE}/seek" --data-urlencode "ms=${1}" ;;
    volume)       [ ${#} -ge 1 ] || die "用法: volume <0..1>"; act -G "${BASE}/volume" --data-urlencode "level=${1}" ;;
    mode)         [ ${#} -ge 1 ] || die "用法: mode <queue|track|off|shuffle>"; act -G "${BASE}/mode" --data-urlencode "loop=${1}" ;;
    search)       [ ${#} -ge 1 ] || die "用法: search <query>"; act -G "${BASE}/search" --data-urlencode "q=${1}" ;;
    play-ref)     [ ${#} -ge 2 ] || die "用法: play-ref <source> <item>"; act -G "${BASE}/play-ref" --data-urlencode "source=${1}" --data-urlencode "item=${2}" ;;
    play-queue)   [ ${#} -ge 1 ] || die "用法: play-queue <index>"; act -G "${BASE}/play-queue" --data-urlencode "i=${1}" ;;
    source)       [ ${#} -ge 2 ] || die "用法: source <id> <true|false>"; act -G "${BASE}/source" --data-urlencode "id=${1}" --data-urlencode "enabled=${2}" ;;
    *)            die "未知命令: ${cmd}（运行 'timbrebox-ctl help'）" ;;
  esac
}

main "${@}"
